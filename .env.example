# Postgres connection string. Works with Supabase ("Connection string" -> URI,
# use the pooled "Transaction" one on Vercel) or Neon (copy from their dashboard).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Secret used to sign auth session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public URL of the deployment (used by the auth library to build callback URLs).
NEXTAUTH_URL=http://localhost:3000

# Server-only key and target user for the Hermes finance integration.
# Do not prefix these names with NEXT_PUBLIC_ and never commit real values.
HERMES_SYNC_TOKEN=
HERMES_SYNC_USER_ID=
